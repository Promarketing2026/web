# Variables públicas: se incorporan al bundle durante `next build`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-26
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Variables privadas: nunca usar el prefijo NEXT_PUBLIC_.
HUBSPOT_SERVICE_KEY=

# Redis vía la integración de Vercel/Upstash. Configurar el par completo.
KV_REST_API_URL=
KV_REST_API_TOKEN=
