# Variables públicas: se incorporan al bundle durante `next build`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-26
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Variables privadas: nunca usar el prefijo NEXT_PUBLIC_.
HUBSPOT_SERVICE_KEY=
HUBSPOT_NEWSLETTER_LIST_ID=

# Redis vía la integración de Vercel/Upstash (acepta KV_REST_API_* o alias UPSTASH_REDIS_REST_*).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Notificaciones por email con Resend (FORM-NOTIFY-1)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Promarketing Perú <notificaciones@promarketingperu.com>"
